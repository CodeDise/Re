# ============================================================================
# CleanReader & Media Summarizer Bot - Environment Variables (.env.example)
# ============================================================================

# 1. Telegram API Credentials (Get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_32_character_telegram_api_hash
BOT_TOKEN=1234567890:AAH_your_botfather_token_here
BOT_USERNAME=CleanReaderBot

# 2. MongoDB Connection (Motor Async Driver)
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=cleanreader_bot_db

# 3. Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# 4. Admin User IDs (Comma or space separated Telegram numeric IDs)
ADMIN_IDS=654321987,987654321

# 5. Force-Subscribe (FSUB) Configuration
# Bot MUST be an Admin in FSUB_CHANNEL_ID to verify membership
FSUB_CHANNEL_ID=-1001987654321
FSUB_INVITE_LINK=https://t.me/+YourChannelInviteLink

# 6. Private Telegram Activity Log & PDF Archive Channel
# Bot MUST be an Admin with Post Messages permission in LOG_CHANNEL_ID
LOG_CHANNEL_ID=-1001122334455

# 7. UI & Branding
START_IMG_URL=https://telegra.ph/file/cleanreader-banner-cover.jpg
SUPPORT_CHAT_URL=https://t.me/CleanReaderSupport

# 8. Monetization, Quotas & UPI Payment Configuration
FREE_DAILY_LIMIT=5
UPI_ID=cleanreader@okaxis
UPI_PAYEE_NAME=CleanReader Pro Subscriptions
CURRENCY_SYMBOL=₹
PLAN_1M_PRICE=99
PLAN_3M_PRICE=249
PLAN_LIFETIME_PRICE=699
